# Import contracts. `py-checks sync` builds this file from the layers that
# exist on disk and from the [contracts] section — there is nothing to edit
# here, the next sync overwrites it. Change the section instead.

[importlinter]
root_packages =
    py_checks

[importlinter:contract:layer-checks]
name = checks imports only what it may
type = forbidden
allow_indirect_imports = True
source_modules =
    py_checks.checks
forbidden_modules =
    py_checks.cli
    py_checks.contracts
    py_checks.environment
    py_checks.mutation
    py_checks.sync

[importlinter:contract:layer-cli]
name = cli imports only what it may
type = forbidden
allow_indirect_imports = True
source_modules =
    py_checks.cli
forbidden_modules =
    py_checks.checks

