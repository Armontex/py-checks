# Контракты импортов. Файл собирает `py-checks sync` из того, какие слои
# есть на диске, и из секции [contracts] — править его нечего, следующий sync
# перезапишет. Менять нужно секцию.

[importlinter]
root_packages =
    py_checks

[importlinter:contract:layer-checks]
name = checks не импортирует чужое
type = forbidden
allow_indirect_imports = True
source_modules =
    py_checks.checks
forbidden_modules =
    py_checks.cli
    py_checks.contracts
    py_checks.environment
    py_checks.mutation
    py_checks.sync

[importlinter:contract:layer-cli]
name = cli не импортирует чужое
type = forbidden
allow_indirect_imports = True
source_modules =
    py_checks.cli
forbidden_modules =
    py_checks.checks

[importlinter:contract:layer-config]
name = config не импортирует чужое
type = forbidden
allow_indirect_imports = True
source_modules =
    py_checks.config
forbidden_modules =
    py_checks.checks
    py_checks.cli
    py_checks.contracts
    py_checks.core
    py_checks.environment
    py_checks.mutation
    py_checks.sync

